# Copy to .env.local and fill in only what you need. Every variable is optional.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enables the map picker on /booking
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Full "Embed a map" iframe src for an exact pin on the landing page
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
# Google Geolocation API fallback for the Smart Local Insights panel
NEXT_PUBLIC_GOOGLE_GEOLOCATION_API_KEY=
